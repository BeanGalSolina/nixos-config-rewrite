prefer-no-csd

layout {
	focus-ring { off; }

	border {
		on
		width 2
		active-color "#9666ff"
		inactive-color "#532b89"
		urgent-color "#fff334"
	}

	tab-indicator {
		active-color "#9666ff"
		inactive-color "#532b89"
		urgent-color "#fff334"
	}
	
	default-column-width { proportion 0.4; }
	gaps 12

	empty-workspace-above-first
}

